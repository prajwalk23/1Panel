# @see: http://editorconfig.org

root = true

# Applies to all files
[*]
# Use utf-8 charset
charset = utf-8
# Line ending type (lf | cr | crlf)
end_of_line = lf
# Always insert a final newline
insert_final_newline = true
# Indent style (tab | space)
indent_style = space
# Indent size
indent_size = 4
# Max line length
max_line_length = 120

# Rules below apply to md files only
[*.md]
# Disable max line length
max_line_length = off
# Disable trailing whitespace trimming
trim_trailing_whitespace = false
